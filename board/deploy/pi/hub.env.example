# /etc/buddy-hub/hub.env (root:buddyhub 0640). PLACEHOLDERS ONLY: never commit real values, and keep this
# file out of the repo's history. Accounts mode (BOARD_AUTH=accounts) is the production mode: people sign in
# with Google, GitHub or an emailed code, create or join teams, and runners enrol per team.
# Never set BOARD_AUTH=dev on an exposed hub: the hub refuses it when BOARD_PUBLIC_URL / BOARD_TUNNEL_PROBE_URL is set.
BOARD_AUTH=accounts
# The hub refuses to start while BOARD_SECRET, the encryption key, a BOARD_SES_* / Resend / OAuth secret or
# BOARD_GITHUB_TOKEN still has a placeholder word (change-me, replace-with, example, placeholder), or
# BOARD_PUBLIC_URL / BOARD_SIGNUP_ALLOW still name example.com/.org/.net.

# --- required ------------------------------------------------------------------------------------------
# Signs sessions, CSRF, OAuth state and invites. AT LEAST 32 BYTES: `openssl rand -base64 48`. Keep it when
# you restore or move the hub (changing it signs everyone out).
BOARD_SECRET=change-me-openssl-rand-base64-48-before-first-start
# Behind the Cloudflare Tunnel the hub trusts the CF-Connecting-IP header for rate limits: ONLY with the
# hub bound to loopback and reachable solely through the tunnel.
BOARD_TRUST_CF_IP=1
BOARD_BIND=127.0.0.1
BOARD_PORT=8787
BOARD_DATA_DIR=/var/lib/buddy-hub
# The public https origin people use (invite links, OAuth redirects, integration webhook URLs).
BOARD_PUBLIC_URL=https://app.example.com
BOARD_LOG_LEVEL=info

# --- encryption key for stored integration secrets (outside the data dir) -------------------------------
# 32 bytes, base64 or hex: `openssl rand -base64 32`. Prefer a root-only file over the variable.
# BOARD_ENC_KEY=
BOARD_ENC_KEY_FILE=/etc/buddy-hub/enc.key

# --- sign-up control (a hub anyone can reach: keep it on `allowlist`) -------------------------------------
# allowlist (default): a NEW account needs a verified email on the list below OR a valid pending invite to
# that email. open: anyone with a Google/GitHub/email account can sign up.
BOARD_SIGNUP=allowlist
# Comma list: domain:example.com,email:someone@example.com
# Entries in lower-case ASCII (punycode, xn--…, for an internationalised domain). Never a public mail provider's
# domain (gmail.com, outlook.com, icloud.com, …): that admits everyone. Use domain: only for a domain where every
# mailbox belongs to one of your people (no shared, alias or customer mailboxes); otherwise list email: entries.
# GitHub sign-ups qualify ONLY through an email: entry, a pending invite or an unlinked member row, never a domain:
# entry (GitHub's "verified" primary can be a mailbox the person lost years ago).
BOARD_SIGNUP_ALLOW=domain:example.com,email:someone@example.com

# --- email sign-in codes and invites (Amazon SES; no SDK) ---------------------------------------------------
# SES starts in the SANDBOX: only verified addresses/domains receive mail (200/day) until AWS grants production
# access. The sender domain needs an SES identity + DKIM records in DNS.
BOARD_MAIL_PROVIDER=ses
BOARD_SES_REGION=us-east-1
BOARD_SES_ACCESS_KEY_ID=replace-with-the-iam-access-key-id
BOARD_SES_SECRET_ACCESS_KEY=change-me
# BOARD_SES_SESSION_TOKEN=
BOARD_MAIL_FROM=Plexiform <no-reply@example.com>
# If the first real send fails with `SES answered 403 (AccessDenied)`, try the bare address form:
# BOARD_SES_FROM_FORMAT=bare
BOARD_MAIL_DAILY_CAP=2000

# --- OAuth sign-in (optional; each needs both values) -------------------------------------------------------
# See board/ACCOUNTS-API.md for the sign-in flows each provider needs.
BOARD_GOOGLE_CLIENT_ID=
BOARD_GOOGLE_CLIENT_SECRET=
BOARD_GITHUB_CLIENT_ID=
BOARD_GITHUB_CLIENT_SECRET=

# Browser /signin: separate web OAuth clients; both values required per provider.
# BOARD_PUBLIC_URL must be an origin only. Register these exact HTTPS callbacks:
# Google: <BOARD_PUBLIC_URL>/api/auth/oauth/web/google/callback
# GitHub: <BOARD_PUBLIC_URL>/api/auth/oauth/web/github/callback (wildcards OFF).
# Google client type: Web application. Keep desktop credentials above unchanged.
BOARD_GOOGLE_WEB_CLIENT_ID=
BOARD_GOOGLE_WEB_CLIENT_SECRET=
BOARD_GITHUB_WEB_CLIENT_ID=
BOARD_GITHUB_WEB_CLIENT_SECRET=
# BOARD_SIGNIN_METHODS=google,github

# --- optional ------------------------------------------------------------------------------------------------
# Public URL of /api/health, probed by the hub itself through the tunnel:
# BOARD_TUNNEL_PROBE_URL=https://app.example.com/api/health
# Remove the Cloudflare Access application from the hostname at cutover: accounts mode has no Access in front of it.
# Read-only fine-grained GitHub token for PR/commit verification + auto-Done:
# BOARD_GITHUB_TOKEN=
# Download page the invite screen links to:
# BOARD_DOWNLOAD_URL=https://example.com/download

# --- first start only (an empty DB) ---------------------------------------------------------------------------
# Creates the first team and its owner, then remove these lines. Skip them if you sign in and create the team
# in the app.
# BOARD_BOOTSTRAP=you@example.com
# BOARD_BOOTSTRAP_BOARD=Team:TM

# --- LEGACY: Cloudflare Access mode (BOARD_AUTH=access) -----------------------------------------------------
# Superseded by accounts mode. These variables only apply with BOARD_AUTH=access and are not used above:
# BOARD_ACCESS_TEAM=
# BOARD_ACCESS_AUD=
