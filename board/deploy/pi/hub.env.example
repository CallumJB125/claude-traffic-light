# /etc/buddy-hub/hub.env (root:buddyhub 0640). Never set BOARD_AUTH=dev on an exposed hub —
# the hub refuses dev auth when BOARD_PUBLIC_URL / BOARD_TUNNEL_PROBE_URL is set.
BOARD_AUTH=access
BOARD_ACCESS_TEAM=restless-hall-ab0c
BOARD_ACCESS_AUD=ada18ae11280c684ddd3686855ac5fa8e62ffa9e7e6e2b476afb648a5274052d
BOARD_BIND=127.0.0.1
BOARD_PORT=8787
BOARD_DATA_DIR=/var/lib/buddy-hub
BOARD_PUBLIC_URL=https://buddy.bondly.co.za
BOARD_TUNNEL_PROBE_URL=https://buddy.bondly.co.za/api/health
BOARD_LOG_LEVEL=info
# First start only (empty DB): creates the org, a board and this owner, then remove the line.
BOARD_BOOTSTRAP=callum.baker.125@gmail.com
BOARD_BOOTSTRAP_BOARD=Bondly:BDL
# Optional, read-only fine-grained GitHub token for PR/commit verification + auto-Done:
# BOARD_GITHUB_TOKEN=
