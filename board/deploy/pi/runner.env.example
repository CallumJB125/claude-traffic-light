# /etc/buddy-runner/runner.env (root:root 0600). PLACEHOLDERS ONLY: never commit real values.
# The cloud runner (buddy-runner.service, docs/CLOUD-RUNNER-RUNBOOK.md). No secret goes in this
# file: the runner token lives in /etc/buddy-runner/runner.token (root 0600, LoadCredential), and
# provider API keys live sealed on the hub (Team page > Cloud runner > Provider keys).

# --- required ----------------------------------------------------------------------------------------
# The hub. On the hub's own host use loopback (no tunnel round trip); elsewhere its https origin.
BUDDY_RUNNER_HUB=http://127.0.0.1:8787
# The team id the token was made for (shown with the token on the Team page).
BUDDY_RUNNER_TEAM=replace-with-the-team-id
# The GitHub repositories this runner may check out, comma separated. Each must also be linked to a
# board of the team, and the hub needs its GitHub App installation token endpoint for them.
BUDDY_RUNNER_REPOS=github.com/owner/repo

# --- AIs ------------------------------------------------------------------------------------------------
# claude and codex bring their own sandboxes. hermes-dgx has none: its tools run as buddyrunner, so it
# is refused unless BUDDY_RUNNER_ALLOW_UNSANDBOXED=1 (and then only for its owner's own dispatches).
BUDDY_RUNNER_AIS=claude,codex
# BUDDY_RUNNER_ALLOW_UNSANDBOXED=0
# Default endpoint for hermes-dgx (a literal tailnet IP; the hub's stored base_url wins per run).
# Also enable the hermes-dgx.conf drop-in so the unit's egress filter lets it through.
# BUDDY_RUNNER_HERMES_ENDPOINT=http://100.68.66.98:8888

# --- caps, per run --------------------------------------------------------------------------------------
BUDDY_RUNNER_MAX_CONCURRENT=2
# Wall clock across all of a run's turns.
BUDDY_RUNNER_MAX_WALL_MINUTES=90
# Input + output tokens across all of a run's turns (the only spend guard for Codex and Hermes).
BUDDY_RUNNER_MAX_TOKENS=3000000
# Dollar cap where the CLI enforces one (Claude Code --max-budget-usd): the lower of this and the card's.
BUDDY_RUNNER_MAX_USD=5
BUDDY_RUNNER_RUN_CPU_PERCENT=200
BUDDY_RUNNER_RUN_TASKS_MAX=512
BUDDY_RUNNER_RUN_MEMORY_MB=4096

# --- optional ---------------------------------------------------------------------------------------------
# cgroup (default): refuse to start without the per-run sandbox. off: no per-run cgroup (tests only).
# BUDDY_RUNNER_SANDBOX=cgroup
# Commit identity in hosted checkouts.
# BUDDY_RUNNER_GIT_NAME=Plexiform cloud runner
# BUDDY_RUNNER_GIT_EMAIL=cloud-runner@users.noreply.github.com
