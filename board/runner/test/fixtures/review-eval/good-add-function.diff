diff --git a/src/money.js b/src/money.js
index 1111111..2222222 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,3 +1,8 @@
 export function cents(usd) {
   return Math.round(usd * 100);
 }
+
+export function formatUsd(cents) {
+  const sign = cents < 0 ? '-' : '';
+  return `${sign}$${(Math.abs(cents) / 100).toFixed(2)}`;
+}
