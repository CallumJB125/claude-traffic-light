<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- electron-builder's defaults (app-builder-lib/templates/entitlements.mac.plist), which setting this file replaces -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Kept: build/sign.js falls back to ad-hoc signing when no Developer ID is in the
         keychain. Ad-hoc code has no Team ID, and under the hardened runtime library
         validation then refuses Electron Framework and its helpers ("mapping process and
         mapped file (non-platform) have different Team IDs"), so the app would not launch.
         No shipped dependency has a native addon (ws's bufferutil/utf-8-validate are not
         installed; the hub uses node:sqlite), so a Developer ID build would not need it. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- F5: under the hardened runtime, EventKit refuses without this (no prompt at all) -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Voice (F7): the hardened runtime blocks the microphone without this -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
