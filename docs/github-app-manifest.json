{
  "name": "Plexiform",
  "url": "https://plexiform.dev",
  "description": "Links pull requests to Plexiform cards: checks and reviews show on the card, a merge moves it to Done, and members can open a card's PR or comment its status.",
  "public": true,
  "hook_attributes": {
    "url": "https://app.plexiform.dev/api/integrations/github/webhook",
    "active": true
  },
  "redirect_url": "https://app.plexiform.dev/?github_app_created=1",
  "callback_urls": [
    "https://app.plexiform.dev/integrations/github/callback"
  ],
  "request_oauth_on_install": true,
  "setup_on_update": true,
  "default_permissions": {
    "metadata": "read",
    "pull_requests": "write",
    "checks": "read",
    "contents": "write",
    "issues": "read"
  },
  "default_events": [
    "pull_request",
    "pull_request_review",
    "check_suite",
    "check_run",
    "push",
    "issue_comment"
  ]
}
