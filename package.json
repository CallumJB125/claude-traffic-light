{
  "name": "claude-buddy",
  "version": "1.0.0",
  "description": "A pixel Claude that lives on your desk: a programmable traffic light for every Claude Code (and Cursor, Codex, Gemini\u2026) session \u2014 lights, moods, costumes, pets, a garden, and clicks that do things.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install-hooks": "node hooks/install.js",
    "dist": "electron-builder --mac",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/build-icons.js",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.callumbaker.claude-buddy",
    "productName": "Claude Buddy",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "settings.html",
      "settings-preload.js",
      "lights.html",
      "lights-preload.js",
      "rig.js",
      "rig.css",
      "rules.js",
      "assets/**/*",
      "hooks/**/*",
      "overlay.html",
      "overlay-preload.js",
      "stats.js",
      "tray.html",
      "tray-preload.js"
    ],
    "extraResources": [
      {
        "from": "hooks",
        "to": "hooks"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  }
}
