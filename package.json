{
  "name": "claude-buddy",
  "productName": "Plexiform",
  "version": "1.0.2",
  "description": "A pixel Claude that lives on your desk: a programmable traffic light for every Claude Code (and Cursor, Codex, Gemini\u2026) session \u2014 lights, moods, costumes, pets, a garden, and clicks that do things.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install-hooks": "node hooks/install.js",
    "predist": "npm run calendar-helper && npm run voice-helper && npm run setups-helper",
    "dist": "electron-builder -c electron-builder.config.js --mac",
    "test": "node --test test/*.test.js test/adapters/*.test.js && npm run test:remote && node --test site/test/*.test.js",
    "test:remote": "npm --prefix remote test",
    "fuzz": "FUZZ_SEQUENCES=${FUZZ_SEQUENCES:-2000} node --test test/state-fuzzer.test.js",
    "icons": "node scripts/build-icons.js",
    "dist:win": "electron-builder -c electron-builder.config.js --win",
    "dist:linux": "electron-builder -c electron-builder.config.js --linux",
    "predist:mac": "npm run calendar-helper && npm run voice-helper && npm run setups-helper",
    "dist:mac": "electron-builder -c electron-builder.config.js --mac",
    "smoke": "node scripts/smoke-installed.js",
    "forget-build": "node scripts/forget-local-build.js",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "tune": "electron tools/tuning-main.js",
    "calendar-helper": "sh scripts/build-calendar-helper.sh",
    "voice-helper": "node scripts/build-voice-helper.js",
    "setups-helper": "sh scripts/build-setups-helper.sh",
    "test:native-darwin": "npm run setups-helper && PLEXIFORM_TEST_HELPER=$PWD/native/setups-build/buddy-setups node --test --test-concurrency=1 test/native-darwin/*.test.js",
    "build:site": "node site/build.js"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "dev.plexiform.app",
    "productName": "Plexiform",
    "files": [
      "main.js",
      "src/**/*",
      "scripts/report-agent-status.js",
      "build/codex-plugins/**/*",
      "build/codex-plugin-key*.pub.pem",
      "!src/update-stub.js",
      "!src/team-hub-fake.js",
      "!node_modules/**/*.{ts,map,d.cts,d.mts,md}",
      "!node_modules/zod/src/**",
      "board/shared/secret-patterns.mjs",
      "preload.js",
      "index.html",
      "sessions.html",
      "sessions.css",
      "sessions.js",
      "sessions-preload.js",
      "memory.html",
      "memory.css",
      "memory.js",
      "memory-preload.js",
      "overview.html",
      "overview.css",
      "overview.js",
      "overview-share.js",
      "overview-directory.js",
      "overview-preload.js",
      "home.html",
      "home.css",
      "home.js",
      "home-preload.js",
      "settings.html",
      "settings-backups.js",
      "burst-chip.js",
      "burst-usage.js",
      "feedback.html",
      "feedback.js",
      "feedback-preload.js",
      "settings.js",
      "privacy-render.js",
      "PRIVACY.md",
      "settings-preload.js",
      "lights.html",
      "lights-view.js",
      "lights-auto.js",
      "lights-errs.js",
      "lights-preload.js",
      "rig.js",
      "characters/**/*",
      "rig.css",
      "tokens.css",
      "motion.js",
      "rules.js",
      "brand.js",
      "build/update-key.pub.pem",
      "build/update-key-beta.pub.pem",
      "build/release-floor.json",
      "help.js",
      "help.html",
      "help-preload.js",
      "onboarding.html",
      "onboarding.js",
      "onboarding-preload.js",
      "updates.html",
      "updates.js",
      "updates-preload.js",
      "hatch.html",
      "hatch-view.js",
      "hatch-preload.js",
      "cameos.js",
      "setup.js",
      "hostapp.js",
      "assets/**/*",
      "hooks/**/*",
      "adapters/**/*",
      "overlay.html",
      "overlay-preload.js",
      "stats.js",
      "usage.js",
      "usage-history.js",
      "usage-insights.js",
      "usage-view.js",
      "usage-waste-view.js",
      "spend.js",
      "mcp-server.js",
      "mcp-install.js",
      "native-board/**/*",
      "agents.js",
      "tray.html",
      "tray-preload.js",
      "buddy-window/**/*",
      "!buddy-window/mock-accounts-hub.js",
      "!buddy-window/dev-walk.js",
      "waiting.html",
      "waiting.js",
      "waiting-preload.js",
      "optimiser.html",
      "optimiser.js",
      "optimiser-preload.js",
      "tasks.html",
      "tasks.js",
      "tasks.css",
      "tasks-preload.js",
      "myday.html",
      "myday.js",
      "myday.css",
      "myday-preload.js",
      "aitools.html",
      "aitools.js",
      "aitools.css",
      "aitools-preload.js",
      "setups.html",
      "setups.js",
      "setups.css",
      "setups-preload.js",
      "checkpoints.html",
      "checkpoints.js",
      "checkpoints.css",
      "checkpoints-preload.js",
      "input-bubble.js",
      "widget.js",
      "input-bubble.css",
      "board/package.json",
      "board/hub/**/*",
      "board/shared/**/*",
      "board/web/**/*",
      "board/runner/**/*",
      "board/mcp/**/*",
      "board/tasks-api/**/*",
      "board/tasks-engine/**/*",
      "!board/tasks-api/mock-server.js",
      "!board/tasks-api/scripts/**",
      "!board/**/test/**",
      "!board/web/mock/**",
      "!board/web/scripts/**",
      "!board/runner/scripts/**",
      "!board/hub/data/**",
      "!board/**/*.db*"
    ],
    "extraResources": [
      {
        "from": "hooks",
        "to": "hooks"
      },
      {
        "from": "adapters",
        "to": "adapters"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "files": ["!assets/icon.ico"],
      "protocols": [{ "name": "Plexiform", "schemes": ["plexiform", "claudebuddy"] }],
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "extendInfo": {
        "NSCalendarsFullAccessUsageDescription": "Plexiform reads when your calendar events start and end, and whether they are marked busy, so it can hold non-urgent pings while you are in a meeting. It does not read event titles unless you turn that on.",
        "NSCalendarsUsageDescription": "Plexiform reads when your calendar events start and end, and whether they are marked busy, so it can hold non-urgent pings while you are in a meeting. It does not read event titles unless you turn that on.",
        "NSMicrophoneUsageDescription": "Plexiform listens only while you hold the talk key or press and hold the widget, to answer your question.",
        "NSSpeechRecognitionUsageDescription": "Plexiform turns your question into text on this Mac. Audio is never stored or sent anywhere."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "native/setups-build",
          "to": "setups",
          "filter": ["buddy-setups", "helper-manifest.json"]
        },
        {
          "from": "native/bin",
          "to": "calendar-helper",
          "filter": [
            "buddy-calendar"
          ]
        },
        {
          "from": "native/voice/build",
          "to": "voice",
          "filter": [
            "buddy-listen"
          ]
        }
      ],
      "sign": "./build/sign.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "board/package.json",
      "board/mcp/**",
      "board/shared/**",
      "board/runner/hook-shim.js",
      "board/runner/procs.js",
      "board/runner/ipc.js",
      "board/runner/launch.js",
      "node_modules/**"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "26.16.1",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0",
    "zod": "^4.6.2"
  }
}
