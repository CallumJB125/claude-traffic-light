{
  "name": "claude-buddy",
  "version": "1.0.0",
  "description": "A pixel Claude that lives on your desk: a programmable traffic light for every Claude Code (and Cursor, Codex, Gemini…) session — lights, moods, costumes, pets, a garden, and clicks that do things.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install-hooks": "node hooks/install.js",
    "predist": "node scripts/build-voice-helper.js",
    "dist": "electron-builder --mac",
    "test": "node --test test/*.test.js test/adapters/*.test.js",
    "fuzz": "FUZZ_SEQUENCES=${FUZZ_SEQUENCES:-2000} node --test test/state-fuzzer.test.js",
    "icons": "node scripts/build-icons.js",
    "cameos": "python3 scripts/build-cameos.py",
    "dist:win": "electron-builder --win --x64",
    "predist:mac": "node scripts/build-voice-helper.js",
    "dist:mac": "electron-builder --mac",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "tune": "electron tools/tuning-main.js",
    "voice-helper": "node scripts/build-voice-helper.js"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.callumbaker.claude-buddy",
    "productName": "Claude Buddy",
    "files": [
      "main.js",
      "src/**/*",
      "preload.js",
      "index.html",
      "settings.html",
      "settings-preload.js",
      "lights.html",
      "lights-view.js",
      "lights-preload.js",
      "rig.js",
      "rig.css",
      "tokens.css",
      "motion.js",
      "rules.js",
      "help.js",
      "help.html",
      "help-preload.js",
      "cameos.js",
      "setup.js",
      "hostapp.js",
      "assets/**/*",
      "!assets/cameos/src/**",
      "hooks/**/*",
      "adapters/**/*",
      "overlay.html",
      "overlay-preload.js",
      "stats.js",
      "usage.js",
      "spend.js",
      "mcp-server.js",
      "mcp-install.js",
      "agents.js",
      "tray.html",
      "tray-preload.js"
    ],
    "extraResources": [
      {
        "from": "hooks",
        "to": "hooks"
      },
      {
        "from": "adapters",
        "to": "adapters"
      },
      {
        "from": "native/voice/build",
        "to": "voice",
        "filter": [
          "buddy-listen"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Claude Buddy listens only while you hold the talk key or press and hold the widget, to answer your question.",
        "NSSpeechRecognitionUsageDescription": "Claude Buddy turns your question into text on this Mac. Audio is never stored or sent anywhere."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  }
}
