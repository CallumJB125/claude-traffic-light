{
  "name": "claude-buddy",
  "version": "1.0.0",
  "description": "A pixel Claude that lives on your desk: a programmable traffic light for every Claude Code (and Cursor, Codex, Gemini…) session — lights, moods, costumes, pets, a garden, and clicks that do things.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install-hooks": "node hooks/install.js",
    "dist": "electron-builder --mac",
    "test": "node --test test/*.test.js",
    "fuzz": "FUZZ_SEQUENCES=${FUZZ_SEQUENCES:-2000} node --test test/state-fuzzer.test.js",
    "icons": "node scripts/build-icons.js",
    "cameos": "python3 scripts/build-cameos.py",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.callumbaker.claude-buddy",
    "productName": "Claude Buddy",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "settings.html",
      "settings-preload.js",
      "lights.html",
      "lights-preload.js",
      "rig.js",
      "rig.css",
      "rules.js",
      "help.js",
      "help.html",
      "help-preload.js",
      "cameos.js",
      "setup.js",
      "hostapp.js",
      "assets/**/*",
      "!assets/cameos/src/**",
      "hooks/**/*",
      "overlay.html",
      "overlay-preload.js",
      "stats.js",
      "usage.js",
      "router.js",
      "router-install.js",
      "mcp-server.js",
      "mcp-install.js",
      "delegation-install.js",
      "agents/**/*",
      "bin/**/*",
      "agents.js",
      "tray.html",
      "tray-preload.js"
    ],
    "extraResources": [
      {
        "from": "hooks",
        "to": "hooks"
      },
      {
        "from": "router.js",
        "to": "router.js"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  }
}
