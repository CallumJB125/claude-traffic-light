    "request": {
      "oneOf": [
        {
          "$ref": "#/$defs/hello"
        },
        {
          "$ref": "#/$defs/status"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/spawn"
        },
        {
          "$ref": "#/$defs/byTty"
        },
        {
          "$ref": "#/$defs/reveal"
        },
        {
          "$ref": "#/$defs/rows.publish"
        },
        {
          "$ref": "#/$defs/jump"
        },
        {
          "$ref": "#/$defs/attach"
        },
        {
          "$ref": "#/$defs/resize"
