{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MAX_THINKING_TOKENS": "31999",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "ANTHROPIC_AUTH_TOKEN": "@@SEED:anthropic_key@@",
    "GITHUB_PERSONAL_ACCESS_TOKEN": "@@SEED:github_pat@@",
    "DEPLOY_PASSWORD": "@@SEED:keyed_spaced@@"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(npm run test:*)",
      "Read(~/.config/**)",
      "WebFetch(domain:github.com)"
    ],
    "deny": ["Read(./.env)", "Bash(curl:*)"],
    "defaultMode": "acceptEdits"
  },
  "apiKeyHelper": "~/.claude/get-key.sh",
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "@@HOME@@/.claude/hooks/guard.sh --token @@SEED:cli_secret_flag@@"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST -d 'done on @@HOST@@' https://ntfy.sh/@@USER@@-alerts"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "@@HOME@@/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
