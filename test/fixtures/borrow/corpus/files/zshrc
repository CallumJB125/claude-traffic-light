# Maintained by @@NAME@@ <@@EMAIL@@> on @@HOSTLOCAL@@
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git z fzf zsh-autosuggestions zsh-syntax-highlighting docker kubectl)
source $ZSH/oh-my-zsh.sh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

export EDITOR="nvim"
export PATH="@@HOME@@/.bun/bin:@@HOME@@/go/bin:/opt/homebrew/bin:$PATH"
export NVM_DIR="$HOME/.nvm"
export CLAUDE_CONFIG_DIR="@@HOME@@/.claude"
export HISTFILE="@@HOME@@/.zsh_history"
export KUBECONFIG="@@HOME@@/.kube/config"
export PROXY_HOST=@@IP@@
setopt HIST_IGNORE_DUPS SHARE_HISTORY
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# --- API keys -------------------------------------------------------------
export ANTHROPIC_API_KEY="@@SEED:anthropic_key@@"
export OPENAI_API_KEY="$(security find-generic-password -s openai -w)"
export GITHUB_TOKEN=$(security find-generic-password -s x -w)
export GH_ENTERPRISE_TOKEN="$(op read op://Private/x/credential)"
export FIGMA_TOKEN="op://Private/x/credential"
export AIDER_OPENAI_API_KEY="$OPENAI_API_KEY"
export GROQ_API_KEY=@@SEED:groq_key@@
export XAI_API_KEY='@@SEED:xai_key@@'
export HOMEBREW_GITHUB_API_TOKEN='@@SEED:github_pat@@'
export STRIPE_API_KEY=@@SEED:stripe_key@@ # test mode
export SLACK_BOT_TOKEN="@@SEED:slack_token@@"
export TELEGRAM_BOT_TOKEN=@@SEED:telegram_bot_token@@
export SENTRY_AUTH_TOKEN=@@SEED:sentry_token@@
export LEGACY_TOKEN=`echo @@SEED:env_secret@@`
export GOOGLE_API_KEY="@@SEED:google_api_key@@"
export AWS_ACCESS_KEY_ID=@@SEED:aws_access_key@@
export AWS_SECRET_ACCESS_KEY=@@SEED:aws_secret@@
export DB_PASSWORD='@@SEED:keyed_spaced@@'   # has spaces
export OPENAI_ORG_TOKEN=\
  "@@SEED:openai_key@@"
export DEPLOY_PASSWORD=\
  @@SEED:keyed@@
export http_proxy="http://@@USER@@:@@SEED:url_credentials@@@@@IP@@:3128"
export SUPABASE_ANON=@@SEED:dash_key@@
# export GITHUB_TOKEN=@@SEED:github_token@@
# webhook signing secret (rotate!): @@SEED:hex_secret@@

# --- aliases --------------------------------------------------------------
alias gs='git status'
alias gl='git log --oneline --graph --decorate'
alias ll='ls -lah'
alias k=kubectl
alias dcu='docker compose up -d'
alias cc='claude --dangerously-skip-permissions'
alias ghapi="curl -H \"Authorization: token @@SEED:github_token@@\" https://api.github.com"
alias vpn='sudo openconnect --user=@@USER@@ --passwd-on-stdin vpn.@@INTHOST@@'
alias deploy='./scripts/deploy.sh --token @@SEED:cli_secret_flag@@ --env prod'
alias ssh-mini='ssh @@USER@@@@@TSHOST2@@'
alias work-ping='ping -c1 @@INTHOST@@'

# --- functions ------------------------------------------------------------
gh-notify() {
  curl -sS -H "Authorization: Bearer @@SEED:bearer@@" \
       -H "Accept: application/vnd.github+json" \
       https://api.github.com/notifications | jq '.[].subject.title'
}
function slack-say() {
  curl -X POST -H 'Content-type: application/json' \
    --data "{\"text\":\"$1\"}" \
    @@SEED:slack_webhook@@
}
mkcd() { mkdir -p "$1" && cd "$1"; }
export DISCORD_BOT=@@SEED:discord_bot_token@@
export PSCALE=@@SEED:planetscale_token@@
hook() { curl -s -H "authorization: bearer @@SEED:bearer_short@@" https://hooks.example.com/ping; }
