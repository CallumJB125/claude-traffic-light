export ZSH="$HOME/.oh-my-zsh"
plugins=(git)

setup_deploy_key() {
  mkdir -p ~/.ssh
  cat > ~/.ssh/deploy_key <<'EOF'
@@SEED:private_key@@
EOF
  chmod 600 ~/.ssh/deploy_key
}
export GIT_SSH_COMMAND="ssh -i ~/.ssh/deploy_key -o IdentitiesOnly=yes"
export SIGNING_KEY="@@SEED:private_key_escaped@@"
alias whoami-mini='ssh @@USER@@@@@TSHOST2@@'
export KUBE_CLIENT_KEY_DATA=@@SEED:pem_base64@@
cat > /tmp/deploy.ppk <<'KEY'
@@SEED:putty_key@@
KEY
cat > ~/.netrc.tmp <<NETRC
machine api.example.com
  login bot
  password @@SEED:netrc_line@@
NETRC
# machine api.acme.co.za login bot password @@SEED:netrc@@
