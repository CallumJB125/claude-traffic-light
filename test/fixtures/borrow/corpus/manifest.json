        "export JAVA_HOME=$(/usr/libexec/java_home -v 21)",
        "export HOMEBREW_NO_ANALYTICS=1",
        "[[ -f \"$HOME/.cargo/env\" ]] && . \"$HOME/.cargo/env\""
      ]
    },
    {
      "file": "bashrc",
      "path": "~/.bashrc",
      "expected": "ok",
      "trimFinalNewline": true,
      "mustKeep": [
