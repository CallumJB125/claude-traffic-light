{
  "about": "Zero-leak corpus. Each file under files/ holds @@SEED:<kind>@@ slots (filled with fresh fake secrets per run) and @@HOME@@ @@USER@@ @@HOST@@ @@HOSTSHORT@@ @@HOSTLOCAL@@ @@EMAIL@@ @@EMAIL2@@ @@NAME@@ @@IP@@ @@IP2@@ @@TSHOST@@ @@TSHOST2@@ @@INTHOST@@ machine slots. path is the ~ path the scanner would report. mustKeep strings must survive verbatim in an 'ok' result; mustKeepMatching are regexes whose every match in the filled input must survive; trimFinalNewline drops the last newline so a secret ends the file. expected 'ok-or-blocked' marks pure credential stores (docker auths, rclone, .pypirc) where refusing to share the file is as acceptable as scrubbing it; if it comes back ok every leak and must-keep check applies.",
  "files": [
    {
      "file": "zshrc",
      "path": "~/.zshrc",
      "expected": "ok",
      "mustKeep": [
        "ZSH_THEME=\"powerlevel10k/powerlevel10k\"",
        "plugins=(git z fzf zsh-autosuggestions zsh-syntax-highlighting docker kubectl)",
        "source $ZSH/oh-my-zsh.sh",
        "[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh",
        "export EDITOR=\"nvim\"",
        "export NVM_DIR=\"$HOME/.nvm\"",
        "export OPENAI_API_KEY=\"$(security find-generic-password -s openai -w)\"",
        "export GITHUB_TOKEN=$(security find-generic-password -s x -w)",
        "$(security find-generic-password -s x -w)",
        "op://Private/x/credential",
        "export AIDER_OPENAI_API_KEY=\"$OPENAI_API_KEY\"",
        "$OPENAI_API_KEY",
        "alias gs='git status'",
        "alias ll='ls -lah'",
        "alias k=kubectl",
        "alias dcu='docker compose up -d'",
        "https://api.github.com",
        "-H \"Accept: application/vnd.github+json\"",
        "gh-notify()",
        "mkcd() { mkdir -p \"$1\" && cd \"$1\"; }"
      ]
    },
    {
      "file": "zprofile",
      "path": "~/.zprofile",
      "expected": "ok",
      "mustKeep": [
        "eval \"$(/opt/homebrew/bin/brew shellenv)\"",
